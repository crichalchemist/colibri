#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
// One workgroup of 256: every invocation records what the subgroup builtins say,
// and what subgroupAdd(1) actually counts.
layout(local_size_x = 256) in;
layout(std430, set = 0, binding = 0) writeonly buffer OUT { uint v[]; } o;
void main() {
    uint i = gl_LocalInvocationID.x;
    uint n = subgroupAdd(1u);
    o.v[i * 5u + 0u] = gl_SubgroupSize;
    o.v[i * 5u + 1u] = gl_SubgroupInvocationID;
    o.v[i * 5u + 2u] = gl_SubgroupID;
    o.v[i * 5u + 3u] = gl_NumSubgroups;
    o.v[i * 5u + 4u] = n;
}
