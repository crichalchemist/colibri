#version 450
// dst[i] = src[i] + tag, over one window of each buffer.
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) readonly buffer IN { float a[]; } src;
layout(std430, set = 0, binding = 1) writeonly buffer OUT { float b[]; } dst;
layout(push_constant) uniform PC { uint n; float tag; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < pc.n) dst.b[i] = src.a[i] + pc.tag;
}
