#version 450
// Two-stage chain as in the expert batch: stage 0 writes h = 2*x + tag into a
// dynamic-offset window; stage 1 reads h through another dynamic window, writes y = h + 1.
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) readonly buffer IN { float a[]; } src;
layout(std430, set = 0, binding = 1) writeonly buffer OUT { float b[]; } dst;
layout(push_constant) uniform PC { int n, stage, tag; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(pc.n)) return;
    dst.b[i] = pc.stage == 0 ? 2.0 * src.a[i] + float(pc.tag) : src.a[i] + 1.0;
}
